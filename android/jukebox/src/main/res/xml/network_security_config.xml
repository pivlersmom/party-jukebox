<?xml version="1.0" encoding="utf-8"?>
<!-- Das Add-on läuft im Heimnetz ohne HTTPS (http://<HA-IP>:8099) – Klartext-HTTP erlauben -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>

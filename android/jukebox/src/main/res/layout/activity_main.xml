<?xml version="1.0" encoding="utf-8"?>
<!-- Hauptansicht: WebView (wird im Code eingefügt) + Hinweis bei Verbindungsfehler -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D14">

    <LinearLayout
        android:id="@+id/offline"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B0D14"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/offline_title"
            android:textColor="@color/pj_text"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/offline_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/pj_text_dim"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/offline_retry_auto"
            android:textColor="@color/pj_text_dim"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/btn_retry"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_primary"
            android:text="@string/offline_retry"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"/>

        <Button
            android:id="@+id/btn_settings"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button"
            android:text="@string/offline_settings"
            android:textAllCaps="false"
            android:textColor="@color/pj_text"
            android:textSize="17sp"/>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Schaltfläche: deutlich sichtbarer Fokus-Rahmen (wichtig für Fernbedienung/D-Pad) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp"/>
            <solid android:color="@color/pj_surface_focus"/>
            <stroke android:width="3dp" android:color="@color/pj_cyan"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp"/>
            <solid android:color="@color/pj_surface_focus"/>
            <stroke android:width="2dp" android:color="@color/pj_pink"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp"/>
            <solid android:color="@color/pj_surface"/>
            <stroke android:width="1dp" android:color="@color/pj_line"/>
        </shape>
    </item>
</selector>

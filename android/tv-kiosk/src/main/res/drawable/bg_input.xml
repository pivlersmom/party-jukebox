<?xml version="1.0" encoding="utf-8"?>
<!-- Eingabefeld mit Fokus-Rahmen -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp"/>
            <solid android:color="#0E1320"/>
            <stroke android:width="3dp" android:color="@color/pj_cyan"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp"/>
            <solid android:color="#0E1320"/>
            <stroke android:width="1dp" android:color="@color/pj_line"/>
        </shape>
    </item>
</selector>

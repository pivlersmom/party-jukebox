<?xml version="1.0" encoding="utf-8"?>
<!-- Einrichtung für den Fernseher: große Schrift, mit Fernbedienung (D-Pad) bedienbar -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pj_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="96dp"
        android:paddingEnd="96dp"
        android:paddingTop="40dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textColor="@color/pj_text"
            android:textSize="30sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/setup_address_label"
            android:textColor="@color/pj_text_dim"
            android:textSize="18sp"/>

        <EditText
            android:id="@+id/address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:importantForAutofill="no"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:inputType="textUri"
            android:maxLines="1"
            android:nextFocusDown="@+id/btn_test"
            android:padding="14dp"
            android:singleLine="true"
            android:textColor="@color/pj_text"
            android:textColorHint="@color/pj_text_dim"
            android:hint="@string/setup_address_default"
            android:textSize="22sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setup_address_hint"
            android:textColor="@color/pj_text_dim"
            android:textSize="16sp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_test"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="180dp"
                android:background="@drawable/bg_button"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/setup_test"
                android:textAllCaps="false"
                android:textColor="@color/pj_text"
                android:textSize="20sp"/>

            <Button
                android:id="@+id/btn_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:minWidth="180dp"
                android:background="@drawable/bg_button_primary"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/setup_save"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:minWidth="180dp"
                android:background="@drawable/bg_button"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/setup_cancel"
                android:textAllCaps="false"
                android:textColor="@color/pj_text"
                android:textSize="20sp"
                android:visibility="gone"/>
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="28dp"
            android:textColor="@color/pj_text"
            android:textSize="18sp"/>

        <CheckBox
            android:id="@+id/autostart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button"
            android:buttonTint="@color/pj_cyan"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp"
            android:text="@string/setup_autostart"
            android:textColor="@color/pj_text"
            android:textSize="18sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/setup_help"
            android:textColor="@color/pj_text_dim"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/pj_text_dim"
            android:textSize="14sp"/>
    </LinearLayout>
</ScrollView>

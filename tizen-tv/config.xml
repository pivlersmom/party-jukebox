<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://github.com/pivlersmom/party-jukebox/tizen-tv" version="1.0.0" viewmodes="maximized">
    <tizen:application id="PJukeTV01.PartyJukeboxTV" package="PJukeTV01" required_version="3.0"/>
    <name>Party-Jukebox TV</name>
    <description>TV-Anzeige des Party-Jukebox-Add-ons für Home Assistant (Song, Songtext, Warteschlange, QR-Code, Gäste)</description>
    <icon src="icon.png"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <access origin="*" subdomains="true"/>
    <tizen:allow-navigation>*</tizen:allow-navigation>
    <tizen:content-security-policy>default-src * 'unsafe-inline' 'unsafe-eval' data: blob:; frame-src *; connect-src *; img-src * data: blob:</tizen:content-security-policy>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
